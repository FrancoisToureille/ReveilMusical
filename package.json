{
  "name": "reveil-musical",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "test": "vitest run --coverage",
    "audit:licenses": "license-checker --production --excludePrivatePackages --json > licenses.json && node scripts/check-licenses.js licenses.json"
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.3",
    "license-checker": "^25.0.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
